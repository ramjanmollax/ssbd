# ==============================================================================
# Seed Haven BD - Environment Variables Configuration Template
# Copy this file to .env and fill in your custom production values.
# DO NOT commit real secrets or passwords to public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js Express server (automatically set by Cloud Run / Render / Heroku / Railway)
PORT=3000

# Node runtime environment (development | production)
NODE_ENV=production

# Canonical public URL of your website (used for dynamic sitemaps, SEO canonical links, and Meta CAPI)
SITE_URL="https://seedhavenbd.com"
APP_URL="https://seedhavenbd.com"

# Client-side base URL (Vite environment variable)
VITE_SITE_URL="https://seedhavenbd.com"
VITE_API_BASE_URL=""

# Allowed CORS origins (comma-separated, or * for all origins)
CORS_ALLOWED_ORIGINS="https://seedhavenbd.com,http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. File Storage & Local Database
# ------------------------------------------------------------------------------
# Directory for persistent JSON database files (orders, secure integration configurations)
DATA_DIR="./data"

# Directory for user-uploaded product images and banners
UPLOADS_DIR="./public/uploads"

# ------------------------------------------------------------------------------
# 3. External Catalogs & Google Sheets
# ------------------------------------------------------------------------------
# Google Sheets Spreadsheet ID for live inventory/product catalog synchronization
GOOGLE_SHEET_ID="1kPzbYFUkgN8dW5BVqeNtoKM8LbRvHAIfQIQZBKkv-Ws"

# ------------------------------------------------------------------------------
# 4. Meta (Facebook) Pixel & Conversions API (CAPI)
# ------------------------------------------------------------------------------
# Meta Dataset / Pixel ID
META_PIXEL_ID=""

# Meta Conversions API Access Token (Server-side tracking)
META_CAPI_ACCESS_TOKEN=""

# Meta Test Event Code (optional, for Meta Events Manager test validation)
META_TEST_EVENT_CODE=""

# ------------------------------------------------------------------------------
# 5. Security & Verification
# ------------------------------------------------------------------------------
# Admin panel access protection / Secret key
ADMIN_SECRET_KEY="change_this_to_a_secure_random_token"

# Google Search Console Verification Token / Meta Tag
GOOGLE_SEARCH_CONSOLE_VERIFICATION=""

# Cloudflare Turnstile / reCAPTCHA Secret Key (if enabled)
CAPTCHA_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 6. Courier & Delivery Integration Credentials (Optional)
# ------------------------------------------------------------------------------
# Steadfast Courier API
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# Pathao Courier API
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""

# RedX Courier API
REDX_ACCESS_TOKEN=""
